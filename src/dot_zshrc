# Registering fish in /etc/shells and chsh live in the macOS/Linux install
# scripts (run_onchange_before_*install_packages) — NOT here. Doing it in the
# interactive rc made chsh prompt "Password for <user>:" on every zsh start
# (echo off → broken input), because $SHELL never updates in-session.

# Starship prompt
eval "$(starship init zsh)"

# Transient prompt — show only character for previous commands
function zle-line-init() {
    emulate -L zsh
    [[ $CONTEXT == start ]] || return 0
    while true; do
        zle .recursive-edit
        local -i ret=$?
        [[ $ret == 0 && $KEYS == $'\4' ]] || break
        [[ -o ignore_eof ]] || exit 0
    done
    local saved_prompt=$PROMPT
    local saved_rprompt=$RPROMPT
    PROMPT="$(starship module character)"
    RPROMPT=""
    zle .reset-prompt
    PROMPT=$saved_prompt
    RPROMPT=$saved_rprompt
    if (( ret )); then
        zle .send-break
    else
        zle .accept-line
    fi
    return ret
}
zle -N zle-line-init

# fzf key bindings
eval "$(fzf --zsh)"

# Atuin shell history
eval "$(atuin init zsh)"

# Zoxide
eval "$(zoxide init zsh)"