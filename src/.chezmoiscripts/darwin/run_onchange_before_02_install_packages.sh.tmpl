#!/usr/bin/env bash

set -uo pipefail
# Note: not using set -e — brew bundle returns exit 1 if any single
# dependency fails, but we want to continue with the rest

{{ $darwin := .packages.darwin -}}

{{/* Always include: common + personal */}}
{{/* Work machines additionally include: work */}}
{{ $taps      := concat (dig "common" "taps"      (list) $darwin) (dig "personal" "taps"      (list) $darwin) -}}
{{ $fonts     := concat (dig "common" "fonts"     (list) $darwin) (dig "personal" "fonts"     (list) $darwin) -}}
{{ $languages := concat (dig "common" "languages" (list) $darwin) (dig "personal" "languages" (list) $darwin) -}}
{{ $cli       := concat (dig "common" "cli"       (list) $darwin) (dig "personal" "cli"       (list) $darwin) -}}
{{ $casks     := concat (dig "common" "casks"     (list) $darwin) (dig "personal" "casks"     (list) $darwin) -}}

{{ if eq .machine_type "work" -}}
{{ $taps      = concat $taps      (dig "work" "taps"      (list) $darwin) -}}
{{ $fonts     = concat $fonts     (dig "work" "fonts"     (list) $darwin) -}}
{{ $languages = concat $languages (dig "work" "languages" (list) $darwin) -}}
{{ $cli       = concat $cli       (dig "work" "cli"       (list) $darwin) -}}
{{ $casks     = concat $casks     (dig "work" "casks"     (list) $darwin) -}}
{{ end -}}

{{ $taps      = $taps      | sortAlpha | uniq -}}
{{ $fonts     = $fonts     | sortAlpha | uniq -}}
{{ $languages = $languages | sortAlpha | uniq -}}
{{ $cli       = $cli       | sortAlpha | uniq -}}
{{ $casks     = $casks     | sortAlpha | uniq -}}

# Tap and trust third-party taps so `brew bundle` and `brew update` succeed
# under the tap-trust requirement (the default since Homebrew 6.0).
# Tap-level trust is used because each of these is a single-formula tap,
# making tap-trust effectively equivalent to per-formula trust by surface area,
# while keeping `brew update` clean (formula-trust only blocks tap updates).
# Trust state is recorded in ~/.homebrew/trust.json and is idempotent.
brew tap armgabrielyan/deadbranch >/dev/null 2>&1 || true
brew tap gabrie30/utils           >/dev/null 2>&1 || true
brew tap bahaaio/pomo             >/dev/null 2>&1 || true
brew trust --tap armgabrielyan/deadbranch >/dev/null 2>&1 || true
brew trust --tap gabrie30/utils           >/dev/null 2>&1 || true
brew trust --tap bahaaio/pomo             >/dev/null 2>&1 || true
brew trust --tap swchck/local             >/dev/null 2>&1 || true
{{ if eq .machine_type "work" -}}
brew tap derailed/k9s            >/dev/null 2>&1 || true
brew tap alesbrelih/gitlab-ci-ls >/dev/null 2>&1 || true
brew trust --tap derailed/k9s            >/dev/null 2>&1 || true
brew trust --tap alesbrelih/gitlab-ci-ls >/dev/null 2>&1 || true
{{ end }}
# ── Version-pinned casks ─────────────────────────────────────────────
# homebrew/cask carries one version per token, and Homebrew 7 refuses to install
# a cask from a loose file, so anything held back needs a tap of its own. These
# are also listed in the Brewfile below — `brew bundle cleanup --force` untaps
# and uninstalls everything it does not see there.
PINNED_TAP="$(brew --repository)/Library/Taps/swchck/homebrew-local"
mkdir -p "$PINNED_TAP/Casks"
{{ range $token := (list "raycast@1") }}
cat >"$PINNED_TAP/Casks/{{ $token }}.rb" <<'CASK'
{{ includeTemplate (printf "casks/%s.rb" $token) . | trim }}
CASK
want=$(awk -F'"' '/^  version /{print $2; exit}' "$PINNED_TAP/Casks/{{ $token }}.rb")
have=$(ls "$(brew --caskroom)/{{ $token }}" 2>/dev/null | head -1)
if [ "$want" != "$have" ]; then
    brew unpin --cask {{ $token }} >/dev/null 2>&1 || true
    brew install --cask --force "swchck/local/{{ $token }}"
fi
# Pinning does not stop a cask with `auto_updates true` from replacing itself —
# Raycast also needs its own "Automatically download & install updates" off.
brew pin --cask {{ $token }} >/dev/null 2>&1 || true
{{ end }}
# Install packages via Brewfile
brew bundle --file=/dev/stdin <<EOF
{{ range $taps -}}
tap "{{ . }}"
{{ end -}}

{{ range $fonts -}}
cask "{{ . }}"
{{ end -}}

{{ range $languages -}}
brew "{{ . }}"
{{ end -}}

{{ range $cli -}}
brew "{{ . }}"
{{ end -}}

{{ range $casks -}}
cask "{{ . }}"
{{ end -}}

{{ range $key, $value := (dig "common" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ range $key, $value := (dig "personal" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ if eq .machine_type "work" -}}
{{ range $key, $value := (dig "work" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ end -}}

{{ range (.vscode.extensions | sortAlpha | uniq) -}}
vscode "{{ . }}"
{{ end -}}
EOF

# Remove packages not in the list
brew bundle cleanup --force --file=/dev/stdin <<EOF
{{ range $taps -}}
tap "{{ . }}"
{{ end -}}

{{ range $fonts -}}
cask "{{ . }}"
{{ end -}}

{{ range $languages -}}
brew "{{ . }}"
{{ end -}}

{{ range $cli -}}
brew "{{ . }}"
{{ end -}}

{{ range $casks -}}
cask "{{ . }}"
{{ end -}}

{{ range $key, $value := (dig "common" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ range $key, $value := (dig "personal" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ if eq .machine_type "work" -}}
{{ range $key, $value := (dig "work" "appstore_apps" (dict) $darwin) -}}
mas "{{$key}}", id: {{$value}}
{{ end -}}
{{ end -}}
EOF

brew autoremove

# ── Set fish as default shell ────────────────────────────────────────
# Done here (once, on change) instead of in ~/.zshrc so it never prompts for
# a password on every interactive shell start. Compare against the real login
# shell from dscl — $SHELL is inherited from the parent process and never
# reflects a chsh made in the same session, which would re-fire the prompt
# forever.
FISH_PATH=$(command -v fish || true)
if [ -n "$FISH_PATH" ]; then
    if ! grep -q "$FISH_PATH" /etc/shells 2>/dev/null; then
        echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
    fi
    current_shell=$(dscl . -read "/Users/$(whoami)" UserShell 2>/dev/null | awk '{print $2}')
    if [ "$current_shell" != "$FISH_PATH" ]; then
        sudo chsh -s "$FISH_PATH" "$(whoami)" || true
    fi
fi
